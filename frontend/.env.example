# Set to true to run frontend against local mock data instead of Encore backend APIs.
VITE_MOCK_MODE=false

# Optional API override when mock mode is false.
# When set, the frontend calls this URL for API requests. The session cookie
# must be scoped to this origin for cross-origin auth to work.
# If absent, the frontend uses same-origin (window.location.origin) or local.
# VITE_API_BASE_URL=http://localhost:4000
