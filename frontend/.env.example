# Set to true to run frontend against local mock data instead of Encore backend APIs.
VITE_MOCK_MODE=false

# Optional API override when mock mode is false.
# VITE_API_BASE_URL=http://localhost:4000

# Backend URL used by the generated Encore client to point at the deployed backend.
# If absent, falls back to VITE_API_BASE_URL or local same-origin.
# VITE_BACKEND_URL=http://localhost:4000
