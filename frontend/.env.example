# Set to true to run frontend against local mock data instead of Encore backend APIs.
VITE_MOCK_MODE=false

# Optional API override when mock mode is false.
# When set, the frontend calls this URL for non-auth API requests (Bearer token
# path). Auth requests (/api/auth/*) are always same-origin via the reverse proxy.
# If absent, the frontend uses same-origin (window.location.origin) or local.
# VITE_API_BASE_URL=http://localhost:4000

# Required for the Deno Deploy auth proxy (frontend/api-proxy.ts).
# Public Encore API origin, e.g. https://production-kutwa.encr.app
# ENCORE_API_BASE_URL=https://production-kutwa.encr.app
