{
  "name": "@lightwing/frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Lightwing frontend powered by TanStack Router + Vite",
  "scripts": {
    "dev": "vite --host --port 5173",
    "dev:mock": "VITE_MOCK_MODE=true vite --host --port 5173",
