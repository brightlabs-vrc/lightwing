# ---------------------------------------------------------------------------
# Lightwing Legacy Frontend — Local Development Overrides
# ---------------------------------------------------------------------------
# Copy this file to .env.local and adjust values as needed.
# These override the values in .env.example for local development.
# IMPORTANT: .env.local is git-ignored and should never be committed.
# ---------------------------------------------------------------------------

# Point the frontend at a local Encore backend (default: http://localhost:4000)
# VITE_API_BASE_URL=http://localhost:4000

# Or override with a specific backend URL (takes precedence over VITE_API_BASE_URL)
# VITE_BACKEND_URL=http://localhost:4000

# Enable mock mode for offline frontend testing (no backend required)
# VITE_MOCK_MODE=true

# Environment name for local development
# VITE_ENV_NAME=development