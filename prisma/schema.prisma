generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClassTier {
  PRE_OP
  OP
  G3
  G2
  G1
}

enum EventOwnerType {
  ORGANIZATION
  USER
}

enum EventStatus {
  DRAFT
  UNOFFICIAL
  OFFICIAL
  CONCLUDED
}

enum SiteRole {
  USER
  SITE_ADMIN
}

model User {
  id           String    @id @db.Text
  name         String    @db.Text
  email        String    @unique @db.Text
  emailVerified Boolean  @default(false)
  image        String?   @db.Text
  biography      String?  @db.Text
  careerOverview String?  @db.Text
  classTier      ClassTier?
  siteRole       SiteRole  @default(USER)
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @db.Timestamp(6)
  sessions     Session[]
  accounts     Account[]
  members      Member[]
  invitations  Invitation[] @relation("InvitationInviter")
  eventMembers   EventMember[]
  eventPoints    EventPointsEntry[]
  eventLadder    EventLadderEntry[]
  ownedEvents    Event[]      @relation("EventOwner")
  eventAdminOf   EventAdmin[]
  raceResults    RaceResult[]

  @@map("user")
}

model Session {
  id        String   @id @db.Text
  expiresAt DateTime @db.Timestamp(6)
  token     String   @unique @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String   @db.Text
  activeOrganizationId String? @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                   String    @id @db.Text
  accountId            String    @db.Text
  providerId           String    @db.Text
  userId               String    @db.Text
  accessToken          String?   @db.Text
  refreshToken         String?   @db.Text
  idToken              String?   @db.Text
  accessTokenExpiresAt DateTime? @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @db.Timestamp(6)
  scope                String?   @db.Text
  password             String?   @db.Text
  createdAt            DateTime  @default(now()) @db.Timestamp(6)
  updatedAt            DateTime  @updatedAt @db.Timestamp(6)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Organization {
  id        String    @id @db.Text
  name      String    @db.Text
  slug      String    @unique @db.Text
  logo      String?   @db.Text
  metadata  Json?
  rankingAverage        Float? @db.DoublePrecision
  pointsAverage         Float? @db.DoublePrecision
  seasonRank            Int?
  averagePointsPerEvent Float? @db.DoublePrecision
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @db.Timestamp(6)
  members   Member[]
  invitations Invitation[]
  events    Event[]

  @@map("organization")
}

model Member {
  id             String   @id @db.Text
  organizationId  String   @db.Text
  userId          String   @db.Text
  role            String   @db.Text @default("member")
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @db.Text
  organizationId  String   @db.Text
  email          String   @db.Text
  role           String   @db.Text
  status         String   @db.Text @default("pending")
  expiresAt      DateTime @db.Timestamp(6)
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  inviterId      String   @db.Text
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User     @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Verification {
  id         String    @id @db.Text
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime  @db.Timestamp(6)
  createdAt  DateTime? @db.Timestamp(6)
  updatedAt  DateTime? @db.Timestamp(6)

  @@map("verification")
}

model Event {
  id               String         @id @db.Text
  name             String         @db.Text
  description      String?        @db.Text
  ownerType        EventOwnerType
  organizationId   String?        @db.Text
  ownerUserId      String?        @db.Text
  status           EventStatus    @default(UNOFFICIAL)
  scoringType      Int            @db.SmallInt
  classRestriction ClassTier?
  createdAt        DateTime       @default(now()) @db.Timestamp(6)
  updatedAt        DateTime       @updatedAt @db.Timestamp(6)
  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?          @relation("EventOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  raceEvents       RaceEvent[]
  admins           EventAdmin[]
  members          EventMember[]
  schedules        EventSchedule[]
  pointsEntries    EventPointsEntry[]
  ladderEntries    EventLadderEntry[]

  @@index([organizationId])
  @@index([ownerUserId])
  @@map("event")
}

model RaceEvent {
  id               String     @id @db.Text
  eventId          String     @db.Text
  name             String     @db.Text
  sequence         Int        @default(0)
  distanceMeters   Int
  trackType        String     @db.Text
  location         String     @db.Text
  scoringType      Int?       @db.SmallInt
  classRestriction ClassTier?
  startsAt         DateTime?  @db.Timestamp(6)
  endsAt           DateTime?  @db.Timestamp(6)
  createdAt        DateTime   @default(now()) @db.Timestamp(6)
  updatedAt        DateTime   @updatedAt @db.Timestamp(6)
  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  results          RaceResult[]

  @@index([eventId])
  @@map("race_event")
}

model RaceResult {
  id          String    @id @db.Text
  raceEventId String    @db.Text
  userId      String    @db.Text
  position    Int?
  points      Int       @default(0)
  // Netkeiba-style descriptive race notes. All nullable so existing results
  // remain valid; informational only and excluded from scoring calculations.
  gateNumber  Int?      @db.SmallInt // Draw / Gate No. (JP: ゲート番号)
  finishTime  String?   @db.Text // Finish Time (JP: タイム), e.g. "1:32.1"
  margin      String?   @db.Text // Distance Behind / Margin (JP: 着差), e.g. "1/2 length", "nose"
  passingOrder String?  @db.Text // Passing Order at calls (JP: 通過順), e.g. "3-2-1"
  final3F     String?   @db.Text // Final 3F split (JP: 上がり3F), e.g. "34.5"
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)
  raceEvent   RaceEvent @relation(fields: [raceEventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raceEventId, userId])
  @@index([raceEventId])
  @@index([userId])
  @@map("race_result")
}

model EventAdmin {
  id        String   @id @db.Text
  eventId   String   @db.Text
  userId    String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_admin")
}

model EventMember {
  id        String   @id @db.Text
  eventId   String   @db.Text
  userId    String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_member")
}

model EventSchedule {
  id        String    @id @db.Text
  eventId   String    @db.Text
  title     String?   @db.Text
  startsAt  DateTime  @db.Timestamp(6)
  endsAt    DateTime? @db.Timestamp(6)
  location  String?   @db.Text
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_schedule")
}

model EventPointsEntry {
  id        String   @id @db.Text
  eventId   String   @db.Text
  userId    String   @db.Text
  points    Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_points_entry")
}

model EventLadderEntry {
  id        String   @id @db.Text
  eventId   String   @db.Text
  userId    String   @db.Text
  elo       Int      @default(1200)
  wins      Int      @default(0)
  losses    Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_ladder_entry")
}

model ScoreCalcTask {
  id         String   @id @db.Text
  eventId    String   @db.Text
  userId     String   @db.Text
  status     String   @db.Text @default("PENDING")
  retryCount Int      @default(0)
  nextRunAt  DateTime @default(now()) @db.Timestamp(6)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  @@index([status])
  @@index([nextRunAt])
  @@index([createdAt])
  @@map("score_calc_task")
}
