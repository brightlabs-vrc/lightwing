{
  "name": "Ubi9",
  "image": "registry.access.redhat.com/ubi9/ubi",
  "forwardPorts": [4000, 5173, 9400],
  "portsAttributes": {
    "4000": { "label": "Encore API", "onAutoForward": "notify" },
    "5173": { "label": "Frontend", "onAutoForward": "openBrowser" },
    "9400": { "label": "Encore Dashboard", "onAutoForward": "notify" }
  },
  "runArgs": ["--privileged"],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "userUid": "1000",
      "userGid": "1000",
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/go:2": {
      "version": "1.26"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts",
      "pnpmVersion": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "postCreateCommand": "dnf install -y dnf-plugins-core && dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo && dnf install -y docker-ce-cli docker-compose-plugin && curl -fsSL https://encore.dev/install.sh | bash && echo 'export PATH=\"$HOME/.encore/bin:$PATH\"' >> ~/.bashrc",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.encore/bin"
  },
  "remoteUser": "vscode"
}
